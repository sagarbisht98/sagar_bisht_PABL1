class Solution:
    def findMinDiff(self, arr, m):

        n = len(arr)

        # Sort the array
        arr.sort()

        # Initialize answer
        ans = float('inf')

        # Check every window of size m
        for i in range(n - m + 1):

            diff = arr[i + m - 1] - arr[i]

            ans = min(ans, diff)

        return ans
