class Solution:
    def hasTripletSum(self, arr, target):
        
        n = len(arr)

        # Sort the array
        arr.sort()

        # Fix one element
        for i in range(n - 2):

            left = i + 1
            right = n - 1

            # Two pointer approach
            while left < right:

                current_sum = arr[i] + arr[left] + arr[right]

                # Triplet found
                if current_sum == target:
                    return True

                # Increase sum
                elif current_sum < target:
                    left += 1

                # Decrease sum
                else:
                    right -= 1

        return False
