class Solution:
    def getMinDiff(self, arr, k):
        n = len(arr)
        
        # Sort the array
        arr.sort()
        
        # Initial answer
        ans = arr[n - 1] - arr[0]
        
        for i in range(1, n):
            
            # Negative height not allowed
            if arr[i] - k < 0:
                continue
            
            # Minimum height
            minimum = min(arr[0] + k, arr[i] - k)
            
            # Maximum height
            maximum = max(arr[i - 1] + k, arr[n - 1] - k)
            
            # Update answer
            ans = min(ans, maximum - minimum)
        
        return ans
